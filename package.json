{
  "name": "qlastakit",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check": "pnpm typecheck && pnpm lint",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "bash db/migrate.sh",
    "lint": "oxlint --type-aware . && oxfmt --check .",
    "format": "oxfmt .",
    "test": "vitest run",
    "contract": "pnpm --filter @qlastakit/api openapi:export && pnpm --filter @qlastakit/api-client generate"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "^2.11.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
