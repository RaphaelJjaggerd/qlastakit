# Copy to .env and adjust. Every service in every language reads these names.
# Tests, CI and the spec export boot from this file alone, so every var that has no
# default in services/api/src/env.ts must have a working value here.
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Second database in the same Postgres, created and migrated by the API test setup
TEST_DB_NAME=app_test
API_PORT=8787
# Comma-separated origins allowed to call the API cross-origin. Empty: none (v1 uses one
# origin through the proxy)
CORS_ORIGINS=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Where the web app finds the API
VITE_API_URL=http://localhost:8787/api
