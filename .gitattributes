# Every text file is LF in the repo and in the working tree, on every OS.
# Bash breaks on CRLF, and mixed endings make noisy diffs.
* text=auto eol=lf

# Binary files: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
