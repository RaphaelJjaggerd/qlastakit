# Model slots for potato-eng scripts. Names are passed to `claude --model`.
# Builder writes code. Checker must differ from builder. Advisor is the
# strongest you have. The scout model is set in .claude/agents/scout.md
# (this repo's copy overrides ~/.claude/agents/scout.md).
TASK_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-opus-5-5
ADVISOR_MODEL=claude-fable-5-2
